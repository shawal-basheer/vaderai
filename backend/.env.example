# Copy this file to .env and fill in your values.
# Never commit the real .env file.

# Required. Your Groq API key.
GROQ_API_KEY=your-groq-api-key-here

# Optional. Which Groq model to use.
# Defaults to openai/gpt-oss-20b if not set.
# Groq retires models periodically. To see what is currently
# available, query https://api.groq.com/openai/v1/models
GROQ_MODEL=openai/gpt-oss-20b
